{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://praxis.dev/schemas/principle.schema.json",
  "title": "Principle",
  "description": "The core database of PraxisOS: a personal action hypothesis earned through testing.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "type", "title", "status", "confidence", "domains", "created_at", "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PRINCIPLE-[A-Z]+-[0-9]{3}$"
    },
    "type": { "const": "principle" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["candidate", "testing", "validated", "core", "revised", "retired"]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "sources": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "related_values": { "type": "array", "items": { "type": "string" } },
    "related_models": { "type": "array", "items": { "type": "string" } },
    "related_principles": { "type": "array", "items": { "type": "string" } },
    "last_tested": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "created_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}