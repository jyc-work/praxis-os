{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://praxis.dev/schemas/model.schema.json",
  "title": "Model",
  "description": "A thinker, philosophy, mental model or world model. Must end in My Interpretation and Derived Principles.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "type", "model_type", "name", "status", "domains", "created_at", "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MODEL-[A-Z]+-[0-9]{3}$"
    },
    "type": { "const": "model" },
    "model_type": {
      "enum": ["thinker", "philosophy", "mental-model", "world-model"]
    },
    "name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1, "description": "e.g. studying, understood, applied, retired" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "derived_principles": { "type": "array", "items": { "type": "string" } },
    "related_values": { "type": "array", "items": { "type": "string" } },
    "created_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}