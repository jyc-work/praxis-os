{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://praxis.dev/schemas/review.schema.json",
  "title": "Review",
  "description": "A periodic or decision review that compares prediction with actual outcome.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "type", "review_type", "status", "created_at", "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REVIEW-[A-Z]+-[0-9]{3}$"
    },
    "type": { "const": "review" },
    "review_type": { "enum": ["weekly", "monthly", "quarterly", "annual", "decision"] },
    "target": { "type": "array", "items": { "type": "string" } },
    "decision_id": { "type": "string", "description": "Shorthand link kept for convenience; target is authoritative." },
    "status": { "enum": ["planned", "completed", "abandoned"] },
    "review_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "principles_changed": { "type": "array", "items": { "type": "string" } },
    "created_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}